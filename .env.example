# CCNA MASTERY Environment Variables

# Next.js Public App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Credentials (Optional - App runs out of the box in Local Storage mode if omitted)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gemini AI API Key (server only; Groq fallback, chat image analysis, and pasted CLI classification)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"

# AI Q&A with Groq (server only; never use NEXT_PUBLIC_ for this key)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_REASONING_EFFORT="high"

# Optional OpenAI alternative; Groq is used first when both keys are configured
OPENAI_API_KEY="your-openai-api-key"
# Optional: default is gpt-6-astra with high reasoning effort
OPENAI_MODEL="gpt-6-astra"
OPENAI_REASONING_EFFORT="high"
